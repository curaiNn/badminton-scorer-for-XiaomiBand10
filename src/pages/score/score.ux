<template>
  <div class="page">
    <!-- 顶栏：与卡片平级，点它不会给任何一方加分 -->
    <div class="top">
      <div class="info" if="{{ !banner }}">
        <text class="info-line">{{ topLine }}</text>
        <div class="games">
          <text class="games-num text-red">{{ gamesRed }}</text>
          <text class="games-sep">:</text>
          <text class="games-num text-blue">{{ gamesBlue }}</text>
        </div>
      </div>
      <div class="info" if="{{ banner }}">
        <text class="{{ bannerCls }}">{{ banner }}</text>
      </div>
      <div class="more" onclick="openMore">
        <div class="more-dot"></div>
        <div class="more-dot more-dot-gap"></div>
        <div class="more-dot more-dot-gap"></div>
      </div>
    </div>

    <!-- 加载中：占住卡片区域，撤销键不跳动 -->
    <div class="cards" if="{{ phase === 'loading' }}"></div>

    <!-- 比赛中：红蓝两张卡片，整张卡片都是点击区域 -->
    <div class="cards" if="{{ phase === 'playing' }}">
      <div class="{{ redCls }}" ontouchstart="pressRed" ontouchend="releaseCards" onclick="tapRed">
        <div class="serve">
          <div class="serve-dot serve-dot-red" if="{{ serveRed }}"></div>
          <text class="serve-text serve-text-red">{{ serveRed }}</text>
        </div>
        <text class="score text-red">{{ red }}</text>
      </div>
      <div class="{{ blueCls }}" ontouchstart="pressBlue" ontouchend="releaseCards" onclick="tapBlue">
        <div class="serve">
          <div class="serve-dot serve-dot-blue" if="{{ serveBlue }}"></div>
          <text class="serve-text serve-text-blue">{{ serveBlue }}</text>
        </div>
        <text class="score text-blue">{{ blue }}</text>
      </div>
    </div>

    <!-- 一局结束 / 比赛结束：替换卡片区域，防止误触计分 -->
    <div class="over" if="{{ phase === 'gameOver' || phase === 'matchOver' }}">
      <text class="{{ overTitleCls }}">{{ overTitle }}</text>
      <div class="over-score">
        <text class="over-num text-red">{{ overRed }}</text>
        <text class="over-sep">:</text>
        <text class="over-num text-blue">{{ overBlue }}</text>
      </div>
      <text class="over-note">{{ overNote }}</text>
      <div class="over-btn" onclick="overAction">
        <text class="over-btn-text">{{ overBtn }}</text>
      </div>
    </div>

    <div class="undo" onclick="tapUndo">
      <text class="{{ undoCls }}">撤销</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { RED, BLUE, deriveMatch } from '../../common/rules.js'
import { newMatch, addPoint, undo, nextGame } from '../../common/match.js'
import { createStore, DEFAULT_SETTINGS } from '../../common/store.js'
import { createDevice } from '../../common/device.js'

const RED_CARD = 'card card-red'
const BLUE_CARD = 'card card-blue card-gap'
const COURT_TEXT = { right: '右区发球', left: '左区发球' }
const SIDE_NAME = { R: '红方', B: '蓝方' }
const TAP_GUARD_MS = 250 // 防止真机一次点击触发两次，计分、撤销、提示层按钮、更多按钮的点击都适用
const OVER_GUARD_MS = 1000 // 一局或比赛刚结束时，提示层按钮正好出现在最后一次点击的位置，这段时间内忽略点击
const EXIT_WINDOW_MS = 2000 // 两次右滑之间的间隔上限
const SWAP_BANNER_MS = 3000

export default {
  private: {
    phase: 'loading', // 第一次读取完成前，卡片和提示层都不渲染
    topLine: '',
    banner: '',
    bannerCls: 'banner',
    gamesRed: '0',
    gamesBlue: '0',
    red: '0',
    blue: '0',
    redCls: RED_CARD,
    blueCls: BLUE_CARD,
    serveRed: '',
    serveBlue: '',
    undoCls: 'undo-text undo-off',
    overTitle: '',
    overTitleCls: 'over-title text-red',
    overRed: '0',
    overBlue: '0',
    overNote: '',
    overBtn: '',
  },

  // 不参与渲染的内部状态
  record: null,
  settings: null,
  store: null,
  device: null,
  loaded: false,
  loading: false, // 正在读取存储。读取期间不进更多页，避免进更多页前的存盘覆盖更多页刚做的修改
  visible: true, // 页面是否在前台。创建时就在前台，不依赖第一次 onShow 是否触发；只有 onHide / onDestroy 会把它置为 false
  reloadOnShow: false, // 下次 onShow 时是否重新读取存储（首次加载在 onInit 里）
  tapAt: 0,
  backAt: 0,
  bannerTimer: 0,

  onInit() {
    this.store = createStore(storage)
    this.device = createDevice(vibrator, brightness)
    this.load()
  },

  // 从更多页回来时重新读取（更多页可能改过记录或设置）；息屏再亮屏时内存里的状态才是最新的（写入可能失败过），不能用存储覆盖
  onShow() {
    this.visible = true
    if (this.reloadOnShow) {
      this.reloadOnShow = false
      this.load()
    } else if (this.settings) {
      this.device.keepScreenOn(this.settings.keepOn)
    }
  },

  onHide() {
    this.visible = false
    this.device.keepScreenOn(false)
  },

  onDestroy() {
    this.visible = false
    clearTimeout(this.bannerTimer)
    this.device.keepScreenOn(false)
  },

  // 第一次右滑只提示，2 秒内再滑一次才交给系统退出
  onBackPress() {
    const now = Date.now()
    if (now - this.backAt < EXIT_WINDOW_MS) return false
    this.backAt = now
    this.showBanner('再滑一次退出', 'banner', EXIT_WINDOW_MS)
    return true
  },

  // 读取失败时保留内存里的状态；只有第一次加载就失败时才开新比赛，避免一次读失败把进行中的比赛清零
  load() {
    const before = this.record
    this.loading = true
    Promise.all([this.store.loadSettings(), this.store.loadMatch()])
      .then(([s, m]) => {
        this.loading = false
        if (s.ok || !this.settings) this.settings = s.settings
        // 读取期间如果又计了分，内存里的记录更新，不能被读回来的旧记录覆盖
        if (this.record === before) {
          if (m.ok) this.record = m.record || newMatch(this.settings.rule)
          else if (!this.record) this.record = newMatch(this.settings.rule)
        }
        this.loaded = true
        this.render()
        // 读取期间页面可能已经切到后台，这时不能再打开常亮
        if (this.visible) this.device.keepScreenOn(this.settings.keepOn)
      })
      .catch(() => {
        this.loading = false
        // 兜底：第一次加载过程中出了意外，用默认设置和新比赛，保证页面能用
        if (this.loaded) return
        this.settings = this.settings || Object.assign({}, DEFAULT_SETTINGS)
        this.record = this.record || newMatch(this.settings.rule)
        this.loaded = true
        this.render()
        if (this.visible) this.device.keepScreenOn(this.settings.keepOn)
      })
  },

  render() {
    const s = deriveMatch(this.record)
    this.phase = s.phase
    this.topLine = '第' + (s.current.index + 1) + '局 · ' + this.record.rule + '分'
    this.gamesRed = String(s.gamesWon.red)
    this.gamesBlue = String(s.gamesWon.blue)
    this.red = String(s.current.red)
    this.blue = String(s.current.blue)
    const serve = s.server ? COURT_TEXT[s.court] : ''
    this.serveRed = s.server === RED ? serve : ''
    this.serveBlue = s.server === BLUE ? serve : ''
    this.undoCls = this.record.pts ? 'undo-text' : 'undo-text undo-off'

    if (s.phase === 'gameOver') {
      const g = s.games[s.completed - 1]
      this.overTitle = SIDE_NAME[g.winner] + '胜第' + s.completed + '局'
      this.overTitleCls = g.winner === RED ? 'over-title text-red' : 'over-title text-blue'
      this.overRed = String(g.red)
      this.overBlue = String(g.blue)
      this.overNote = '交换场地后开始下一局'
      this.overBtn = '下一局'
    } else if (s.phase === 'matchOver') {
      this.overTitle = SIDE_NAME[s.matchWinner] + '获胜'
      this.overTitleCls = s.matchWinner === RED ? 'over-title text-red' : 'over-title text-blue'
      this.overRed = String(s.gamesWon.red)
      this.overBlue = String(s.gamesWon.blue)
      this.overNote = s.games.map((g) => g.red + ':' + g.blue).join('  ')
      this.overBtn = '新比赛'
    }
  },

  pressRed() {
    this.redCls = RED_CARD + ' card-red-on'
  },

  pressBlue() {
    this.blueCls = BLUE_CARD + ' card-blue-on'
  },

  // 真机上 touchend 偶尔丢失，所以 click 里也恢复一次
  releaseCards() {
    this.redCls = RED_CARD
    this.blueCls = BLUE_CARD
  },

  tapRed() {
    this.releaseCards()
    this.score(RED)
  },

  tapBlue() {
    this.releaseCards()
    this.score(BLUE)
  },

  score(side) {
    if (!this.loaded) return
    if (!this.guard()) return
    const result = addPoint(this.record, side)
    if (!result.event) return
    this.commit(result.record, result.event)
    // 让 guard() 在接下来的 OVER_GUARD_MS 内都拒绝点击（guard 只看 now - tapAt 是否小于 TAP_GUARD_MS）
    if (result.event === 'game' || result.event === 'match') this.tapAt = Date.now() + OVER_GUARD_MS - TAP_GUARD_MS
    if (result.event === 'swapEnds') this.showBanner('换边', 'banner banner-swap', SWAP_BANNER_MS)
  },

  // 真机上一次点击偶尔触发两次：所有点击操作共用 250ms 防抖
  guard() {
    const now = Date.now()
    if (now - this.tapAt < TAP_GUARD_MS) return false
    this.tapAt = now
    return true
  },

  tapUndo() {
    if (!this.loaded || !this.record.pts) return
    if (!this.guard()) return
    this.hideBanner() // 撤销后「换边」之类的提示可能已经不成立
    this.commit(undo(this.record), 'undo')
  },

  // 提示层按钮：一局结束时进入下一局，比赛结束时开新比赛（新比赛按当前设置的赛制）
  overAction() {
    if (!this.loaded) return
    if (!this.guard()) return
    if (this.phase === 'gameOver') this.commit(nextGame(this.record), null)
    else if (this.phase === 'matchOver') this.commit(newMatch(this.settings.rule), null)
  },

  // 改记录 → 推算并刷新 → 存盘 → 振动
  commit(record, event) {
    this.record = record
    this.render()
    this.store.saveMatch(record)
    if (event) this.device.buzz(event, this.settings.vibrate)
  },

  hideBanner() {
    clearTimeout(this.bannerTimer)
    this.banner = ''
    this.backAt = 0 // 「再滑一次退出」的提示一起收起了，下一次右滑要重新提示，不能直接退出
  },

  showBanner(text, cls, ms) {
    clearTimeout(this.bannerTimer)
    this.banner = text
    this.bannerCls = cls
    this.bannerTimer = setTimeout(() => {
      this.banner = ''
    }, ms)
  },

  // 两页各自打包，不能共享模块变量，错误码通过路由参数带过去
  openMore() {
    if (!this.loaded || this.loading || !this.guard()) return
    // 离开前再存一次：之前写失败过的话，更多页和回来后的重新读取都能看到内存里的比赛。不等待结果
    this.store.saveMatch(this.record)
    this.reloadOnShow = true // 更多页可能改过记录或设置，回来时重新读取
    router.push({
      uri: '/pages/more',
      params: { err: this.store.lastError() || this.device.lastError() },
    })
  },
}
</script>

<style>
.page {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  padding-top: 18px;
  padding-bottom: 22px;
  background-color: #000000;
}

/* 126px 宽、居中：左缘约 43、右缘约 169，避开胶囊顶端的圆弧 */
.top {
  width: 126px;
  height: 64px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.info {
  flex-direction: column;
  justify-content: center;
}

.info-line {
  font-size: 14px;
  color: #8a8a8a;
}

.games {
  flex-direction: row;
  align-items: center;
}

.games-num {
  font-size: 20px;
  font-weight: bold;
}

.games-sep {
  margin-left: 4px;
  margin-right: 4px;
  font-size: 20px;
  color: #8a8a8a;
}

.banner {
  font-size: 13px;
  color: #eeeeee;
}

.banner-swap {
  font-size: 20px;
  font-weight: bold;
  color: #ffd27a;
}

.more {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-color: #262626;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.more-dot {
  width: 5px;
  height: 5px;
  border-radius: 3px;
  background-color: #dddddd;
}

.more-dot-gap {
  margin-left: 4px;
}

.cards {
  width: 188px;
  flex-grow: 1;
  flex-direction: column;
}

.card {
  flex-grow: 1;
  border-radius: 20px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.card-red {
  background-color: #3a1215;
}

.card-red-on {
  background-color: #4a181c;
}

.card-blue {
  background-color: #0e1d3a;
}

.card-blue-on {
  background-color: #14284d;
}

.card-gap {
  margin-top: 8px;
}

/* 发球行固定高度：有没有发球提示，比分位置都不跳 */
.serve {
  height: 22px;
  flex-direction: row;
  align-items: center;
}

.serve-dot {
  width: 8px;
  height: 8px;
  margin-right: 6px;
  border-radius: 4px;
}

.serve-dot-red {
  background-color: #ff5c61;
}

.serve-dot-blue {
  background-color: #4f8fff;
}

.serve-text {
  font-size: 14px;
}

.serve-text-red {
  color: #ff9a9d;
}

.serve-text-blue {
  color: #9dbeff;
}

/* 行高不低于字号的约 1.15 倍，数字才不会被裁切（miSmash 在手环10 上实测） */
.score {
  width: 168px;
  height: 110px;
  line-height: 110px;
  font-size: 96px;
  font-weight: bold;
  text-align: center;
}

.text-red {
  color: #ff5c61;
}

.text-blue {
  color: #4f8fff;
}

.over {
  width: 188px;
  flex-grow: 1;
  border-radius: 20px;
  background-color: #141414;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.over-title {
  font-size: 18px;
  text-align: center;
}

.over-score {
  margin-top: 6px;
  flex-direction: row;
  align-items: center;
}

.over-num {
  height: 58px;
  line-height: 58px;
  font-size: 48px;
  font-weight: bold;
}

.over-sep {
  margin-left: 8px;
  margin-right: 8px;
  font-size: 40px;
  color: #777777;
}

.over-note {
  width: 168px;
  margin-top: 6px;
  font-size: 13px;
  color: #8a8a8a;
  text-align: center;
}

.over-btn {
  width: 140px;
  height: 48px;
  margin-top: 16px;
  border-radius: 24px;
  background-color: #eeeeee;
  justify-content: center;
  align-items: center;
}

.over-btn-text {
  font-size: 18px;
  color: #111111;
}

.undo {
  width: 112px;
  height: 44px;
  margin-top: 10px;
  border-radius: 22px;
  background-color: #1f1f1f;
  justify-content: center;
  align-items: center;
}

.undo-text {
  font-size: 16px;
  color: #d8d8d8;
}

.undo-off {
  color: #555555;
}
</style>
